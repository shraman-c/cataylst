import { createClient, SupabaseClient } from '@supabase/supabase-js';
import { randomUUID } from 'crypto';

/**
 * Supabase configuration
 */
const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = process.env.SUPABASE_ANON_KEY;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;

if (!SUPABASE_URL) {
  throw new Error('SUPABASE_URL is not defined in the environment');
}

if (!SUPABASE_ANON_KEY) {
  throw new Error('SUPABASE_ANON_KEY is not defined in the environment');
}

// In dev we cache the client on the global object to prevent creating many connections on hot reload
declare global {
  // eslint-disable-next-line no-var
  var __SUPABASE_CLIENT: SupabaseClient | undefined;
  // eslint-disable-next-line no-var
  var __SUPABASE_ADMIN_CLIENT: SupabaseClient | undefined;
}

/**
 * Creates a Supabase client with anon key (for client-side operations)
 */
function createAnonClient(): SupabaseClient {
  return createClient(SUPABASE_URL!, SUPABASE_ANON_KEY!, {
    auth: {
      persistSession: false, // For server-side usage
    },
  });
}

/**
 * Creates a Supabase client with service role key (for admin operations)
 */
function createAdminClient(): SupabaseClient {
  if (!SUPABASE_SERVICE_ROLE_KEY) {
    throw new Error('SUPABASE_SERVICE_ROLE_KEY is required for admin operations');
  }
  
  return createClient(SUPABASE_URL!, SUPABASE_SERVICE_ROLE_KEY!, {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  });
}

/**
 * Get Supabase client (anon key) - for general database operations
 * This maintains the same interface as the MongoDB connection
 */
export function getSupabaseClient(): SupabaseClient {
  if (!global.__SUPABASE_CLIENT) {
    global.__SUPABASE_CLIENT = createAnonClient();
  }
  return global.__SUPABASE_CLIENT;
}

/**
 * Get Supabase admin client (service role key) - for admin operations
 */
export function getSupabaseAdminClient(): SupabaseClient {
  if (!global.__SUPABASE_ADMIN_CLIENT) {
    global.__SUPABASE_ADMIN_CLIENT = createAdminClient();
  }
  return global.__SUPABASE_ADMIN_CLIENT;
}

/**
 * Main connection function for database operations
 * Returns the Supabase client for database operations
 */
export async function connectToDatabase(): Promise<{ client: SupabaseClient; db: SupabaseClient }> {
  const client = getSupabaseClient();
  
  // Test the connection
  try {
    const { error } = await client.from('students').select('count', { count: 'exact', head: true });
    if (error && error.code !== 'PGRST116') { // PGRST116 is "table not found" which is ok during setup
      console.error('[Supabase] Connection test failed:', error);
      throw new Error('Failed to connect to Supabase: ' + error.message);
    }
    console.log('[Supabase] Connected to', SUPABASE_URL);
  } catch (err) {
    console.error('[Supabase] Connection failed:', err);
    throw err;
  }

  // Return client as both client and db for database operations
  return { client, db: client };
}

/**
 * Database collection helpers for CRUD operations
 * Provides structured access to all application tables
 */
export function collections() {
  const client = getSupabaseClient();
  
  return {
    students: {
      find: () => client.from('students').select('*'),
      findOne: (filter: any) => client.from('students').select('*').eq('custom_id', filter.id).single(),
      insertOne: (doc: any) => client.from('students').insert({
        custom_id: doc.id,
        name: doc.name,
        student_id: doc.studentId,
        electives: doc.electives,
        credits: doc.credits,
        program_id: doc.programId,
        current_semester: doc.currentSemester,
        section_id: doc.sectionId
      }),
      insertMany: (docs: any[]) => client.from('students').insert(
        docs.map(doc => ({
          custom_id: doc.id,
          name: doc.name,
          student_id: doc.studentId,
          electives: doc.electives,
          credits: doc.credits,
          program_id: doc.programId,
          current_semester: doc.currentSemester,
          section_id: doc.sectionId
        }))
      ),
      updateOne: (filter: any, update: any) => client.from('students')
        .update({
          name: update.$set?.name,
          student_id: update.$set?.studentId,
          electives: update.$set?.electives,
          credits: update.$set?.credits,
          program_id: update.$set?.programId,
          current_semester: update.$set?.currentSemester,
          section_id: update.$set?.sectionId
        })
        .eq('custom_id', filter.id),
      deleteMany: () => client.from('students').delete().neq('id', '00000000-0000-0000-0000-000000000000'), // Delete all
      replaceOne: (filter: any, doc: any) => client.from('students')
        .upsert({
          custom_id: doc.id,
          name: doc.name,
          student_id: doc.studentId,
          electives: doc.electives,
          credits: doc.credits,
          program_id: doc.programId,
          current_semester: doc.currentSemester,
          section_id: doc.sectionId
        }, { onConflict: 'custom_id' })
    },
    teachers: {
      find: () => client.from('teachers').select('*'),
      findOne: (filter: any) => client.from('teachers').select('*').eq('custom_id', filter.id).single(),
      insertOne: (doc: any) => client.from('teachers').insert({
        custom_id: doc.id,
        name: doc.name,
        teacher_id: doc.teacherId,
        subjects: doc.subjects,
        availability: doc.availability,
        designation: doc.designation,
        qualification: doc.qualification,
        working_hours: doc.workingHours,
        department: doc.department,
        departmental_role: doc.departmentalRole,
        departmental_permissions: doc.departmentalPermissions
      }),
      insertMany: (docs: any[]) => client.from('teachers').insert(
        docs.map(doc => ({
          custom_id: doc.id,
          name: doc.name,
          teacher_id: doc.teacherId,
          subjects: doc.subjects,
          availability: doc.availability,
          designation: doc.designation,
          qualification: doc.qualification,
          working_hours: doc.workingHours,
          department: doc.department,
          departmental_role: doc.departmentalRole,
          departmental_permissions: doc.departmentalPermissions
        }))
      ),
      updateOne: (filter: any, update: any) => client.from('teachers')
        .update({
          name: update.$set?.name,
          teacher_id: update.$set?.teacherId,
          subjects: update.$set?.subjects,
          availability: update.$set?.availability,
          designation: update.$set?.designation,
          qualification: update.$set?.qualification,
          working_hours: update.$set?.workingHours,
          department: update.$set?.department,
          departmental_role: update.$set?.departmentalRole,
          departmental_permissions: update.$set?.departmentalPermissions
        })
        .eq('custom_id', filter.id),
      deleteMany: () => client.from('teachers').delete().neq('id', '00000000-0000-0000-0000-000000000000'), // Delete all
      replaceOne: (filter: any, doc: any) => client.from('teachers')
        .upsert({
          custom_id: doc.id,
          name: doc.name,
          teacher_id: doc.teacherId,
          subjects: doc.subjects,
          availability: doc.availability,
          designation: doc.designation,
