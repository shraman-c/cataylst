}

/**
 * Helper function to convert Supabase rows to application format
 */
export function convertSupabaseToMongo(rows: any[], type: string): any[] {
  return rows.map(row => {
    switch (type) {
      case 'students':
        return {
          id: row.custom_id,
          name: row.name,
          studentId: row.student_id,
          electives: row.electives,
          credits: row.credits,
          programId: row.program_id,
          currentSemester: row.current_semester,
          sectionId: row.section_id
        };
      case 'teachers':
        return {
          id: row.custom_id,
          name: row.name,
          teacherId: row.teacher_id,
          subjects: row.subjects,
          availability: row.availability,
          designation: row.designation,
          qualification: row.qualification,
          workingHours: row.working_hours,
          department: row.department,
          departmentalRole: row.departmental_role,
          departmentalPermissions: row.departmental_permissions
        };
      case 'programs':
        return {
          id: row.custom_id,
          name: row.name,
          code: row.code,
          totalSemesters: row.total_semesters,
          description: row.description,
          isNEP: row.is_nep || false
        };
      case 'courses':
        return {
          id: row.id, // Use course code as id
          name: row.name,
          credits: row.credits,
          classesPerWeek: row.classes_per_week,
          isLab: row.is_lab,
          semester: row.semester,
          programId: row.program_id,
          isElective: row.is_elective,
          prerequisiteCourses: row.prerequisite_courses || [],
          isNEP: row.is_nep,
          nepCourseType: row.nep_course_type,
          department: row.department
        };
      case 'rooms':
        return {
          id: row.custom_id,
          name: row.name,
          capacity: row.capacity,
          isLab: row.is_lab
        };
      case 'sections':
        return {
          id: row.custom_id,
          name: row.name,
          programId: row.program_id,
          semester: row.semester,
          capacity: row.capacity,
          currentEnrollment: row.current_enrollment,
          roomPreference: row.room_preference,
          shift: row.shift,
          isActive: row.is_active
        };
      case 'timetables':
        return {
          id: row.custom_id,
          day: row.day,
          timeStart: row.time_start,
          timeEnd: row.time_end,
          courseId: row.course_id,
          teacherId: row.teacher_id,
          roomId: row.room_id
        };
      case 'changeRequests':
        return {
          _id: row.custom_id,
          requesterId: row.requester_id,
          requesterName: row.requester_name,
          slotId: row.slot_id,
          requestDetails: row.request_details,
          status: row.status,
          createdAt: new Date(row.created_at)
        };
      case 'departments':
        return {
          code: row.code,
          name: row.name,
          description: row.description,
          headOfDepartment: row.head_of_department,
          contactEmail: row.contact_email,
          contactPhone: row.contact_phone,
          building: row.building,
          floor: row.floor,
          roomNumbers: row.room_numbers,
          establishedYear: row.established_year,
          createdAt: new Date(row.created_at),
          updatedAt: new Date(row.updated_at)
        };
      case 'labs':
        return {
          id: row.custom_id,
          name: row.name,
          departmentCode: row.department_code,
          roomNumber: row.room_number,
          capacity: row.capacity,
          equipment: row.equipment,
          labType: row.lab_type,
          labIncharge: row.lab_incharge,
          maintenanceSchedule: row.maintenance_schedule,
          safetyProtocols: row.safety_protocols,
          operatingHours: row.operating_hours,
          isActive: row.is_active,
          createdAt: new Date(row.created_at),
          updatedAt: new Date(row.updated_at)
        };
      default:
        return row;
    }
  });
}

